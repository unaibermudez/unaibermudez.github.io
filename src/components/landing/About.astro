---
import T from "@/components/T.astro";
import { yearsOfExperience } from "@/utils/career";

const stackPrimary = ["React", "TypeScript", "Java", "Spring Boot", "PostgreSQL"];
const stackSecondary = ["Docker", "OAuth2", "JWT", "Redux Toolkit", "Liquibase", "CI/CD"];
const years = yearsOfExperience();
const timeline = ["lks", "intern", "fs", "edu"] as const;
---

<section class="section about-sec" id="sobre">
	<div class="sec-head lr">
		<div>
			<p class="sec-index"><T k="about.index" /></p>
			<h2 class="sec-title"><T k="about.title" /></h2>
		</div>
		<p class="sec-note"><T k="about.note" /></p>
	</div>

	<div class="about-card">
		<div class="about-grid">
			<p class="about-quote" id="about-quote"><T k="about.quote" /></p>
			<div class="about-side">
				<p><T k="about.bio1" vars={{ years }} /></p>
				<p><T k="about.bio2" /></p>

				<div class="about-stack">
					<div class="stack-group">
						<span class="stack-label"><T k="about.stackPrimary" /></span>
						<div class="tags">
							{stackPrimary.map((t) => <span>{t}</span>)}
						</div>
					</div>
					<div class="stack-group">
						<span class="stack-label"><T k="about.stackAlso" /></span>
						<div class="tags">
							{stackSecondary.map((t) => <span>{t}</span>)}
						</div>
					</div>
				</div>

				<div class="about-stats">
					<div class="about-stat">
						<div class="v" data-count={years}>0</div>
						<div class="l"><T k="about.statYears" /></div>
					</div>
					<div class="about-stat">
						<div class="v" data-count="3">0</div>
						<div class="l"><T k="about.statLangs" /></div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="exp lr">
		<h3 class="exp-title"><T k="experience.title" /></h3>
		<ol class="exp-list">
			{
				timeline.map((key) => (
					<li class="exp-item">
						<span class="exp-period">
							<T k={`experience.${key}.period`} />
						</span>
						<div class="exp-body">
							<h4 class="exp-role">
								<T k={`experience.${key}.role`} />
							</h4>
							<p class="exp-org">
								<T k={`experience.${key}.org`} />
							</p>
							<p class="exp-desc">
								<T k={`experience.${key}.desc`} />
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.about-card {
		background: hsl(var(--theme-text));
		color: hsl(var(--theme-bg));
		border-radius: 28px;
		padding: 4rem 3.5rem;
	}
	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 4rem;
		align-items: start;
	}
	.about-quote {
		font-family: var(--font-serif);
		font-weight: 300;
		font-size: clamp(1.6rem, 3.2vw, 2.5rem);
		line-height: 1.32;
		letter-spacing: -0.015em;
		margin: 0;
	}
	.about-quote :global(.w) {
		opacity: 0.35;
		transition: opacity 0.4s ease;
	}
	.about-quote :global(.w.lit) {
		opacity: 1;
	}
	/* El bloque invierte el tema: usa el azul pensado para el fondo contrario (--klein-inv). */
	.about-quote :global(em) {
		font-style: italic;
		color: var(--klein-inv);
	}
	.about-side p {
		color: hsl(var(--theme-bg) / 0.78);
		margin: 0 0 1.4rem;
		font-size: 0.98rem;
		line-height: 1.65;
	}
	.about-side :global(strong) {
		color: hsl(var(--theme-bg));
		font-weight: 600;
	}

	.about-stack {
		margin-top: 1.8rem;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}
	.stack-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: hsl(var(--theme-bg) / 0.68);
		margin-bottom: 0.55rem;
	}
	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.tags span {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.03em;
		border: 1px solid hsl(var(--theme-bg) / 0.28);
		border-radius: 99px;
		padding: 0.32rem 0.8rem;
		color: hsl(var(--theme-bg) / 0.9);
	}

	.about-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		background: hsl(var(--theme-bg) / 0.18);
		border: 1px solid hsl(var(--theme-bg) / 0.18);
		border-radius: 14px;
		overflow: hidden;
		margin-top: 2.2rem;
	}
	.about-stat {
		background: hsl(var(--theme-text));
		padding: 1.3rem 0.9rem;
		text-align: center;
	}
	.about-stat .v {
		font-family: var(--font-serif);
		font-size: 1.7rem;
		font-weight: 400;
		color: var(--klein-inv);
		white-space: nowrap;
	}
	.about-stat .l {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: hsl(var(--theme-bg) / 0.68);
		margin-top: 0.3rem;
	}

	/* ---- trayectoria ---- */
	.exp {
		margin-top: 5rem;
	}
	.exp-title {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--klein);
		margin: 0 0 1.4rem;
	}
	.exp-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid hsl(var(--theme-text));
	}
	.exp-item {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 2rem;
		padding: 1.9rem 0;
		border-bottom: 1px solid var(--hairline);
	}
	.exp-period {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: hsl(var(--theme-text-muted));
		white-space: nowrap;
		padding-top: 0.35rem;
	}
	.exp-role {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: 1.45rem;
		letter-spacing: -0.01em;
		line-height: 1.2;
		margin: 0;
		color: hsl(var(--theme-text));
	}
	.exp-org {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--klein);
		margin: 0.3rem 0 0.8rem;
	}
	.exp-desc {
		color: hsl(var(--theme-text-muted));
		max-width: 64ch;
		margin: 0;
	}

	@media (max-width: 960px) {
		.about-grid { grid-template-columns: 1fr; }
		.about-card { padding: 3rem 1.8rem; }
	}
	@media (max-width: 760px) {
		.about-card { border-radius: 20px; padding: 2.6rem 1.4rem; }
		.exp { margin-top: 3.5rem; }
		.exp-item { grid-template-columns: 1fr; gap: 0.5rem; padding: 1.5rem 0; }
		.exp-period { padding-top: 0; }
	}
	@media (max-width: 480px) {
		.about-stats { grid-template-columns: 1fr; }
	}
</style>
